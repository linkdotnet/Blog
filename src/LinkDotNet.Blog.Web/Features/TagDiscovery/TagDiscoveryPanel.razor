@inject ITagQueryService TagQueryService
@inject IOptions<ApplicationConfiguration> AppConfiguration
@inject NavigationManager Navigation

@if (AppConfiguration.Value.EnableTagDiscoveryPanel && IsOpen)
{
    <NativeDialog Class="dialog-fullscreen tag-sheet-dialog" IsOpen="true" OnClose="Close" aria-labelledby="tag-sheet-title">
        <div class="sheet-container" @onclick="Close">
            <div class="sheet" @onclick:stopPropagation="true">

                <header class="sheet-header">
                    <h2 id="tag-sheet-title" class="sheet-title">Discover topics</h2>
                    <button type="button" class="sheet-done" @onclick="Close">Done</button>
                </header>

                @if (_tags.Count == 0)
                {
                    <p class="sheet-empty">No topics available yet.</p>
                }
                else
                {
                    <div class="sheet-controls">
                        <input type="search"
                               class="form-control rounded-pill"
                               placeholder="Search topics"
                               aria-label="Search topics"
                               autocomplete="off"
                               @bind="_searchTerm"
                               @bind:event="oninput" />

                        <SegmentedControl Options="@(Enum.GetValues<TagSortOrder>())" @bind-Value="_sortOrder"
                                          Label="@(o => o == TagSortOrder.Popular ? "Popular" : "A–Z")" AriaLabel="Sort topics" />
                    </div>

                    <div class="sheet-scroll">
                        @foreach (var group in GetGroups())
                        {
                            <section>
                                @if (group.Header is not null)
                                {
                                    <h3 class="group-header">@group.Header</h3>
                                }
                                <ul class="group">
                                    @foreach (var tag in group.Tags)
                                    {
                                        <li>
                                            <button type="button" class="tag-row"
                                                    aria-label="@tag.Name, @tag.Count @(tag.Count == 1 ? "post" : "posts")"
                                                    @onclick="() => Navigate(tag.Name)">
                                                <span class="tag-name">@tag.Name</span>
                                                <span class="tag-count" aria-hidden="true">@tag.Count</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (!_hasMatches)
                        {
                            <p class="sheet-empty">No topics match “@TrimmedSearchTerm”.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </NativeDialog>
}

@code {
    private enum TagSortOrder
    {
        Popular,
        Alphabetical,
    }

    private const string NonLetterSection = "#";

    private sealed record TagGroup(string? Header, IReadOnlyList<TagCount> Tags);

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<TagCount> _tags = [];
    private TagSortOrder _sortOrder = TagSortOrder.Popular;
    private string _searchTerm = string.Empty;
    private bool _hasMatches = true;
    private bool _wasOpen;

    private string TrimmedSearchTerm => _searchTerm.Trim();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _searchTerm = string.Empty;
            _sortOrder = TagSortOrder.Popular;
        }

        _wasOpen = IsOpen;

        if (IsOpen)
        {
            _tags = await TagQueryService.GetAllOrderedByUsageAsync();
        }
    }

    private IReadOnlyList<TagGroup> GetGroups()
    {
        var matches = _tags
            .Where(t => t.Name.Contains(TrimmedSearchTerm, StringComparison.CurrentCultureIgnoreCase))
            .ToList();
        _hasMatches = matches.Count > 0;

        if (_sortOrder == TagSortOrder.Popular)
        {
            return _hasMatches ? [new TagGroup(null, matches)] : [];
        }

        return matches
            .OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase)
            .GroupBy(t => GetSectionHeader(t.Name))
            .OrderBy(g => g.Key == NonLetterSection)
            .Select(g => new TagGroup(g.Key, g.ToList()))
            .ToList();
    }

    private static string GetSectionHeader(string tagName) =>
        char.IsLetter(tagName[0]) ? char.ToUpperInvariant(tagName[0]).ToString() : NonLetterSection;

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task Navigate(string tag)
    {
        var encoded = Uri.EscapeDataString(tag);
        Navigation.NavigateTo($"/searchByTag/{encoded}");
        await Close();
    }
}
