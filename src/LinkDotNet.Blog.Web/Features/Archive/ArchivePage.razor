@page "/archive"
@using LinkDotNet.Blog.Infrastructure.Persistence
@using LinkDotNet.Blog.Domain
@using System.Collections.Immutable
@using System.Globalization
@inject IRepository<BlogPost> Repository
@inject IOptions<ApplicationConfiguration> AppConfiguration

<PageTitle>Archive @AppConfiguration.Value.BlogName</PageTitle>
<OgData Title="Archive" Description="Explore all blog posts." />

<div class="container">
	<h3 class="fs-3xl fw-bold pb-6 mb-0">Archive (@blogPostCount posts)</h3>

	@if (blogPostsPerYear is null)
	{
		<Loading></Loading>
	}
	else
	{
		<div class="accordion accordion-gap">
		@foreach (var yearGroup in blogPostsPerYear)
		{
			<details class="accordion-item" open>
				<summary class="accordion-header gap-4" id="@HeadingKey(yearGroup.Key)">
					<span class="fs-xl fw-bold">@yearGroup.Key</span>
					<span class="fg-3 fs-sm">@yearGroup.Count() posts</span>
					<AccordionIcon />
				</summary>
				<ul class="list-group list-group-flush">
					@foreach (var blogPost in yearGroup.OrderByDescending(b => b.UpdatedDate))
					{
						<li class="list-group-item list-group-item-action position-relative d-flex flex-wrap justify-content-between align-items-baseline column-gap-5">
							<a href="/blogPost/@blogPost.Id/@blogPost.Slug" class="fg-reset text-decoration-none stretched-link">@blogPost.Title</a>
							<time class="fg-3 fs-sm" datetime="@blogPost.UpdatedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@blogPost.UpdatedDate.ToString("MMM dd", CultureInfo.CurrentCulture)</time>
						</li>
					}
				</ul>
			</details>
		}
		</div>
	}
</div>

@code {
	private IReadOnlyCollection<IGrouping<int, BlogPostPerYear>>? blogPostsPerYear;
	private int blogPostCount;

	protected override async Task OnInitializedAsync()
	{
		var blogPosts = await Repository.GetAllByProjectionAsync(
			p => new BlogPostPerYear(p.Id, p.Slug, p.Title, p.UpdatedDate),
			p => p.IsPublished);

		blogPostCount = blogPosts.Count;
		blogPostsPerYear = blogPosts
			.GroupBy(r => r.UpdatedDate.Year)
			.OrderByDescending(r => r.Key)
			.ToImmutableArray();
	}

	private static string HeadingKey(int year) => $"heading{year}";

	private sealed record BlogPostPerYear(string Id, string Slug, string Title, DateTime UpdatedDate);
}
