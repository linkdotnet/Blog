@page "/bookmarks"
@using System.Threading
@using LinkDotNet.Blog.Domain
@using LinkDotNet.Blog.Infrastructure.Persistence
@using LinkDotNet.Blog.Web.Features.Bookmarks.Components
@inject IBookmarkService BookmarkService
@inject IRepository<BlogPost> BlogPostRepository
@implements IDisposable

<div class="container bookmarks-page">
	<header class="page-header">
		<h1 class="large-title">Bookmarks</h1>
		@if (!isLoading && bookmarkedPosts.Count > 0)
		{
			<p class="subtitle">@(bookmarkedPosts.Count) saved @(bookmarkedPosts.Count == 1 ? "article" : "articles")</p>
		}
	</header>

	@if (isLoading)
	{
		<ul class="list-group-inset skeleton" aria-hidden="true">
			@for (var i = 0; i < 3; i++)
			{
				<li class="skeleton-row"><span class="skeleton-thumbnail"></span><span class="skeleton-text"></span></li>
			}
		</ul>
	}
	else if (bookmarkedPosts.Count == 0)
	{
		<section class="empty-state" aria-labelledby="empty-title">
			<svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
				<path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1H4z" />
			</svg>
			<h2 id="empty-title" class="empty-title">No Bookmarks Yet</h2>
			<p class="empty-text">Tap the bookmark icon on any article to save it here for later.</p>
			<a class="btn btn-solid theme-primary rounded-pill px-6" href="/">Browse Articles</a>
			<p class="empty-footnote">Bookmarks are stored in this browser and are not synced across devices.</p>
		</section>
	}
	else
	{
		<div class="toolbar">
			<label class="search-field">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
					<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
				</svg>
				<input type="search" placeholder="Search bookmarks" aria-label="Search bookmarks" autocomplete="off"
				       @bind="SearchTerm" @bind:event="oninput" />
			</label>
			<SegmentedControl Options="@(Enum.GetValues<SortOrder>())" @bind-Value="sortOrder" Label="SortLabel" AriaLabel="Sort bookmarks" />
		</div>

		var visiblePosts = GetVisiblePosts();
		@if (visiblePosts.Count == 0)
		{
			<p class="no-results">No results for “@SearchTerm”.</p>
		}
		else
		{
			<ul class="list-group-inset">
				@foreach (var post in visiblePosts)
				{
					<BookmarkRow @key="post.Id" BlogPost="post" OnRemove="RemoveBookmark" />
				}
			</ul>
		}
	}

	@if (recentlyRemoved is not null)
	{
		<div class="undo-bar" role="status">
			<span class="undo-message">Removed “@recentlyRemoved.Title”</span>
			<button type="button" class="undo-button" @onclick="UndoRemoval">Undo</button>
		</div>
	}
</div>

@code {
	private enum SortOrder
	{
		Newest,
		Title,
		ReadingTime,
	}

	private static readonly TimeSpan UndoDuration = TimeSpan.FromSeconds(6);

	private List<BlogPost> bookmarkedPosts = [];
	private BlogPost? recentlyRemoved;
	private CancellationTokenSource? undoTimeout;
	private SortOrder sortOrder = SortOrder.Newest;
	private bool isLoading = true;

	private string SearchTerm { get; set; } = string.Empty;

	private List<BlogPost> GetVisiblePosts() => Sort(bookmarkedPosts.Where(MatchesSearch)).ToList();

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		var ids = await BookmarkService.GetBookmarkedPostIds();

		if (ids.Any())
		{
			var posts = await BlogPostRepository.GetAllByProjectionAsync(post => post, post => ids.Contains(post.Id));
			bookmarkedPosts = posts.ToList();
		}

		isLoading = false;
		StateHasChanged();
	}

	private async Task RemoveBookmark(BlogPost post)
	{
		await BookmarkService.SetBookmark(post.Id, false);
		bookmarkedPosts.Remove(post);
		recentlyRemoved = post;
		ScheduleUndoExpiry();
	}

	private async Task UndoRemoval()
	{
		var post = recentlyRemoved;
		if (post is null)
		{
			return;
		}

		recentlyRemoved = null;
		CancelUndoTimeout();
		await BookmarkService.SetBookmark(post.Id, true);
		bookmarkedPosts.Add(post);
	}

	private void ScheduleUndoExpiry()
	{
		CancelUndoTimeout();
		undoTimeout = new CancellationTokenSource();
		_ = ExpireUndoAfterDelay(undoTimeout);
	}

	private async Task ExpireUndoAfterDelay(CancellationTokenSource timeout)
	{
		try
		{
			await Task.Delay(UndoDuration, timeout.Token);
			await InvokeAsync(() =>
			{
				if (ReferenceEquals(undoTimeout, timeout))
				{
					DismissUndo();
				}
			});
		}
		catch (OperationCanceledException)
		{
			// A newer removal or undo replaced this timer.
		}
	}

	private void DismissUndo()
	{
		CancelUndoTimeout();
		recentlyRemoved = null;
		StateHasChanged();
	}

	private void CancelUndoTimeout()
	{
		undoTimeout?.Cancel();
		undoTimeout?.Dispose();
		undoTimeout = null;
	}

	private bool MatchesSearch(BlogPost post) =>
		SearchTerm.Length == 0
		|| post.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
		|| post.ShortDescription.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
		|| post.Tags.Any(tag => tag.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

	private IEnumerable<BlogPost> Sort(IEnumerable<BlogPost> posts) => sortOrder switch
	{
		SortOrder.Title => posts.OrderBy(p => p.Title, StringComparer.CurrentCultureIgnoreCase),
		SortOrder.ReadingTime => posts.OrderBy(p => p.ReadingTimeInMinutes).ThenBy(p => p.Title),
		_ => posts.OrderByDescending(p => p.UpdatedDate),
	};

	private static string SortLabel(SortOrder order) => order switch
	{
		SortOrder.Title => "Title",
		SortOrder.ReadingTime => "Reading time",
		_ => "Newest",
	};

	public void Dispose()
	{
		CancelUndoTimeout();
	}
}
