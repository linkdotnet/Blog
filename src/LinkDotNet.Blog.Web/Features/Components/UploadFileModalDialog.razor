<NativeDialog Class="dialog-lg" IsOpen="isOpen" OnClose="Abort">
    <div class="dialog-header">
        <h5 class="dialog-title">Configuration</h5>
        <button type="button" class="btn-close" aria-label="Close" @onclick="Abort"></button>
    </div>
    <div class="dialog-body overflow-auto">
        <EditForm Model="@model" OnValidSubmit="Ok">
            <DataAnnotationsValidator />
            <div class="form-floating mb-5">
	                    <label for="name">The filename of the media file. On services like Azure, this can include the directory path.</label>
	                    <InputText type="text" class="form-control" id="name" placeholder="Filename"
	                               @bind-Value="model.Name"/>
	                    <ValidationMessage For="() => model.Name"></ValidationMessage>
            </div>
            <div class="form-field mb-5">
                <div class="switch">
                    <InputCheckbox id="cache" role="switch" @bind-Value="model.CacheMedia" />
                </div>
                <label for="cache">Enable Media Caching</label>
                <small class="form-text fg-3">If enabled, the "Cache-Control" header will be set automatically.<br/>The value is set to one week. If disabled, no header will be set.</small>
            </div>
        </EditForm>
    </div>
    <div class="dialog-footer">
        <button id="abort" type="button" class="btn btn-solid theme-secondary" @onclick="Abort">Abort</button>
        <button type="button" class="btn btn-solid theme-primary" @onclick="Ok">OK</button>
            </div>
</NativeDialog>

@code {
    private TaskCompletionSource<UploadFileModalDialogObject?> result = null!;
    private bool isOpen;
    private readonly UploadFileModalDialogObject model = new();

    public async Task<UploadFileModalDialogObject?> ShowAsync(string fileName)
    {
        isOpen = true;
        model.Name = fileName;
        result = new TaskCompletionSource<UploadFileModalDialogObject?>();
        StateHasChanged();
        return await result.Task;
    }

    private void Abort()
    {
        isOpen = false;
        result.SetResult(null);
        StateHasChanged();
    }

    private void Ok()
    {
        isOpen = false;
        result.SetResult(model);
        StateHasChanged();
    }
}
