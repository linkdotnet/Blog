@using LinkDotNet.Blog.Web.Features.AboutMe.Components.Skill
@using LinkDotNet.Blog.Web.Features.AboutMe.Components.Talk

<div class="d-flex flex-column gap-6">
	<div class="nav nav-pills segmented-control" id="aboutMe" role="tablist" aria-label="About me sections">
		<button class="nav-link flex-fill justify-content-center active" id="pills-skills-tab"
		        data-bs-toggle="tab" data-bs-target="#pills-home"
		        type="button" role="tab" aria-controls="pills-home" aria-selected="true">
			Skills
		</button>
		<button class="nav-link flex-fill justify-content-center" id="pills-talks-tab"
		        data-bs-toggle="tab" data-bs-target="#pills-profile"
		        type="button" role="tab" aria-controls="pills-profile" aria-selected="false" tabindex="-1">
			Talks
		</button>
	</div>

	<div class="tab-content" id="myTabContent">
		<div class="tab-pane active" id="pills-home"
		     role="tabpanel" aria-labelledby="pills-skills-tab" tabindex="0">
			<SkillTable ShowAdminActions="@IsAuthenticated"></SkillTable>
		</div>
		<div class="tab-pane" id="pills-profile"
		     role="tabpanel" aria-labelledby="pills-talks-tab" tabindex="0">
			<Talks ShowAdminActions="@IsAuthenticated"></Talks>
		</div>
	</div>
</div>

@code {
    [Parameter]
    public bool IsAuthenticated { get; set; }
}
