{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "src": "docs",
        "files": ["**/*.md", "toc.yml"],
        "dest": "."
      },
      {
        "files": ["MIGRATION.md"]
      }
    ],
    "resource": [
      {
        "src": "docs",
        "files": ["**/images/**"],
        "dest": "."
      },
      {
        "files": ["assets/overview.gif"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "LinkDotNet.Blog",
      "_appTitle": "LinkDotNet.Blog",
      "_appFooter": "Released under the MIT License.",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
