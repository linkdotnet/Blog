@using LinkDotNet.Blog.Domain
@using LinkDotNet.Blog.Infrastructure.Persistence
@inject IRepository<Skill> Repository
@if (ShowAdminActions)
{
	<div class="d-flex flex-wrap align-items-center gap-4 mb-5">
		<button type="button" class="btn btn-subtle theme-primary" @onclick="() => AddSkillDialog.Open()">
			<i class="bi bi-plus-lg" aria-hidden="true"></i> Add skill
		</button>
		<span class="fs-xs fg-3">Drag a skill onto another level to change it.</span>
	</div>
	<AddSkillDialog @ref="AddSkillDialog" SkillAdded="@AddSkill"></AddSkillDialog>
}
@if (skills.Count == 0 && !ShowAdminActions)
{
	<p class="fs-sm fg-3">No skills yet.</p>
}
<div class="skill-grid" id="skill-table">
	@foreach (var capability in skills.GroupBy(s => s.Capability).OrderByDescending(g => g.Count()).ThenBy(g => g.Key))
	{
		<section class="skill-card d-flex flex-column gap-5 mb-5 p-6 rounded-9 bg-body" aria-label="@capability.Key">
			<header class="d-flex justify-content-between align-items-baseline gap-3">
				<h3 class="m-0 fs-md fw-semibold">@capability.Key</h3>
				<span class="fs-xs fg-3">@capability.Count()</span>
			</header>
			@for (var i = 0; i < LevelsDescending.Length; i++)
			{
				var level = LevelsDescending[i];
				var rank = LevelsDescending.Length - i;
				var skillsInLevel = capability.Where(s => s.ProficiencyLevel == level).OrderBy(s => s.Name).ToList();
				if (skillsInLevel.Count > 0 || ShowAdminActions)
				{
					<div class="proficiency-level d-flex flex-column gap-3" data-level="@level.Key"
					     ondragover="event.preventDefault();" @ondrop="@(() => HandleDrop(level))">
						<h4 class="d-flex align-items-center gap-3 m-0 fs-xs fw-semibold text-uppercase fg-3">
							<span class="level-meter" aria-hidden="true">
								@for (var dot = 1; dot <= LevelsDescending.Length; dot++)
								{
									<i class="@(dot <= rank ? "filled" : null)"></i>
								}
							</span>
							@level.Key
						</h4>
						<ul class="skill-pills list-unstyled d-flex flex-wrap gap-2 m-0">
							@foreach (var skill in skillsInLevel)
							{
								<li draggable="@(ShowAdminActions ? "true" : null)"
								    class="@(ShowAdminActions ? "skill-draggable" : null)"
								    @ondrag="@(() => currentDragItem = skill)">
									<SkillTag Skill="@skill"
									          ShowAdminActions="@ShowAdminActions"
									          DeleteSkill="@(() => DeleteSkill(skill))"/>
								</li>
							}
						</ul>
					</div>
				}
			}
		</section>
	}
</div>
@code {
    private static readonly ProficiencyLevel[] LevelsDescending = [ProficiencyLevel.Expert, ProficiencyLevel.Proficient, ProficiencyLevel.Familiar];

    [Parameter]
    public bool ShowAdminActions { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    private AddSkillDialog AddSkillDialog { get; set; } = default!;

    private List<Skill> skills = [];

    private Skill? currentDragItem;

    protected override async Task OnInitializedAsync()
    {
        skills = (await Repository.GetAllAsync()).ToList();
    }

    private async Task AddSkill(Skill skillToAdd)
    {
        skills.Add(skillToAdd);
        await Repository.StoreAsync(skillToAdd);
        await Changed.InvokeAsync();
    }

    private async Task DeleteSkill(Skill skill)
    {
        skills.Remove(skill);
        await Repository.DeleteAsync(skill.Id);
        await Changed.InvokeAsync();
    }

    private async Task HandleDrop(ProficiencyLevel proficiencyLevel)
    {
        if (!ShowAdminActions || currentDragItem is null || currentDragItem.ProficiencyLevel == proficiencyLevel)
        {
            return;
        }

        currentDragItem.SetProficiencyLevel(proficiencyLevel);
        await Repository.StoreAsync(currentDragItem);
        currentDragItem = null;
    }
}
