@using LinkDotNet.Blog.Web.Features.Services
@inject IOptions<ApplicationConfiguration> AppConfiguration
@inject ICurrentUserService CurrentUserService

<AuthorizeView>
    <Authorized>
        <li class="nav-item">
            <a class="nav-link" href="#" id="adminDropdown" role="button" data-bs-toggle="menu"
               aria-expanded="false">
                <i class="user-tie"></i> Admin
            </a>
            <div class="menu" aria-labelledby="adminDropdown">
                <h6 class="menu-header">Blog posts</h6>
                <a class="menu-item" href="create">Create new</a>
                <a class="menu-item" href="draft">Show drafts</a>
                <a class="menu-item" href="settings">Show settings</a>
                <hr class="menu-divider">
                <h6 class="menu-header">Analytics</h6>
                <a class="menu-item" href="dashboard">Dashboard</a>
                @if (AppConfiguration.Value.EnableBrokenLinkChecker)
                {
                    <a class="menu-item" href="broken-links">Broken links</a>
                }
                <hr class="menu-divider">
                <h6 class="menu-header">Others</h6>
                <a class="menu-item" href="short-codes">Shortcodes</a>
                <hr class="menu-divider">
	            <a class="menu-item" target="_blank" href="https://github.com/linkdotnet/Blog/releases" rel="noreferrer">Releases</a>
            </div>
        </li>
        @if (authorName is not null)
        {
            <li class="nav-item">
                <a class="nav-link" href="#" id="authorDropdown" role="button" data-bs-toggle="menu" aria-expanded="false">
                    <i class="user-tie"></i> @authorName
                </a>
                <div class="menu" aria-labelledby="authorDropdown">
                    <a class="menu-item" href="logout?redirectUri=@CurrentUri"><i class="lock"></i> Log out</a>
                </div>
            </li>
        }
        else
        {
            <li class="nav-item"><a class="nav-link" href="/logout?redirectUri=@CurrentUri"><i class="lock"></i> Log out</a></li>
        }
    </Authorized>
    <NotAuthorized>
        <li class="nav-item"><a class="nav-link" href="/login?redirectUri=@CurrentUri" rel="nofollow"><i class="unlocked"></i> Log in</a></li>
    </NotAuthorized>
</AuthorizeView>

@code {
	[Parameter]
    public string CurrentUri { get; set; } = string.Empty;

    private string? authorName;

    protected override async Task OnInitializedAsync()
    {
        if (AppConfiguration.Value.UseMultiAuthorMode)
        {
            authorName = await CurrentUserService.GetDisplayNameAsync();
        }
    }
}
