@page "/search"
@page "/search/{searchTerm}"
@using LinkDotNet.Blog.Domain
@using LinkDotNet.Blog.Infrastructure
@using LinkDotNet.Blog.Infrastructure.Persistence
@inject IRepository<BlogPost> BlogPostRepository
@inject NavigationManager NavigationManager

<PageTitle>@(HasTerm ? $"Results for: {term}" : "Search")</PageTitle>

<SearchResultsView Title="@(HasTerm ? $"Results for “{term}”" : "Search")"
                   Posts="blogPosts"
                   Query="@term"
                   QueryChanged="Search"
                   EmptyTitle="@(HasTerm ? "No results found" : "Search the blog")"
                   EmptyHint="@(HasTerm ? "Check the spelling or pick one of the topics below." : "Look up articles by title or topic, or start with one of these.")" />

@code {
    [Parameter]
    public string? SearchTerm { get; set; }

    private IReadOnlyList<BlogPost> blogPosts = PagedList<BlogPost>.Empty;
    private string term = string.Empty;
    private int searchVersion;

    private bool HasTerm => term.Length > 0;

    protected override async Task OnParametersSetAsync()
    {
        var requestedTerm = Uri.UnescapeDataString(SearchTerm ?? string.Empty);
        var version = ++searchVersion;
        term = requestedTerm;
        if (!HasTerm)
        {
            blogPosts = PagedList<BlogPost>.Empty;
            return;
        }

        var results = await BlogPostRepository.GetAllAsync(t => t.IsPublished && (t.Title.Contains(requestedTerm)
                                                                                  || t.Tags.Any(tag => tag == requestedTerm)),
            b => b.UpdatedDate);

        if (version == searchVersion)
        {
            blogPosts = results;
        }
    }

    private void Search(string newTerm)
    {
        var target = newTerm.Length == 0 ? "search" : $"search/{Uri.EscapeDataString(newTerm)}";
        NavigationManager.NavigateTo(target, replace: true);
    }
}
