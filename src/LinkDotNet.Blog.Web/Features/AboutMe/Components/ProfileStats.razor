@using System.Globalization
@using LinkDotNet.Blog.Domain
@using LinkDotNet.Blog.Infrastructure.Persistence
@inject IRepository<Domain.Talk> TalkRepository
@inject IRepository<Domain.Skill> SkillRepository
@inject TimeProvider TimeProvider

@if (talkCount > 0 || skillCount > 0)
{
	<dl class="d-flex m-0 py-4 border-y text-center">
		@if (talkCount > 0)
		{
			<div class="stat flex-fill min-w-0 d-flex flex-column align-items-center px-1">
				<dt class="fs-xs fw-semibold text-uppercase fg-3">Talks</dt>
				<dd class="stat-value m-0 fs-lg fw-bold">@talkCount</dd>
				<dd class="stat-detail m-0 fs-xs fg-3 text-truncate w-100">since @firstTalkYear</dd>
			</div>
		}
		@if (skillCount > 0)
		{
			<div class="stat flex-fill min-w-0 d-flex flex-column align-items-center px-1">
				<dt class="fs-xs fw-semibold text-uppercase fg-3">Skills</dt>
				<dd class="stat-value m-0 fs-lg fw-bold">@skillCount</dd>
				<dd class="stat-detail m-0 fs-xs fg-3 text-truncate w-100">in @areaCount @(areaCount == 1 ? "area" : "areas")</dd>
			</div>
		}
		@if (spotlightTalk is not null)
		{
			<div class="stat flex-fill min-w-0 d-flex flex-column align-items-center px-1">
				<dt class="fs-xs fw-semibold text-uppercase fg-3">@(isUpcoming ? "Next talk" : "Latest talk")</dt>
				<dd class="stat-value m-0 fs-lg fw-bold">
					<time datetime="@spotlightTalk.PublishedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
						@spotlightTalk.PublishedDate.ToString("d MMM", CultureInfo.InvariantCulture)
					</time>
				</dd>
				<dd class="stat-detail m-0 fs-xs fg-3 text-truncate w-100">@SpotlightDetail</dd>
			</div>
		}
	</dl>
}

@code {
	private int talkCount;
	private int firstTalkYear;
	private int skillCount;
	private int areaCount;
	private Domain.Talk? spotlightTalk;
	private bool isUpcoming;
	private DateTime today;

	[PersistentState]
	public List<Domain.Talk>? PersistedTalks { get; set; }

	[PersistentState]
	public List<Domain.Skill>? PersistedSkills { get; set; }

	private string SpotlightDetail => (spotlightTalk!.PublishedDate.Date - today).Days switch
	{
		_ when !isUpcoming => spotlightTalk.PublishedDate.Year.ToString(CultureInfo.InvariantCulture),
		0 => "today",
		1 => "tomorrow",
		var days => $"in {days} days",
	};

	protected override Task OnInitializedAsync() => LoadAsync();

	public async Task RefreshAsync()
	{
		PersistedTalks = null;
		PersistedSkills = null;
		await LoadAsync();
		StateHasChanged();
	}

	private async Task LoadAsync()
	{
		today = TimeProvider.GetLocalNow().Date;
		var talks = PersistedTalks ??= (await TalkRepository.GetAllAsync(orderBy: t => t.PublishedDate, descending: false)).ToList();
		var skills = PersistedSkills ??= (await SkillRepository.GetAllAsync()).ToList();

		talkCount = talks.Count;
		firstTalkYear = talks.FirstOrDefault()?.PublishedDate.Year ?? 0;
		skillCount = skills.Count;
		areaCount = skills.Select(s => s.Capability).Distinct(StringComparer.OrdinalIgnoreCase).Count();

		spotlightTalk = talks.FirstOrDefault(t => t.PublishedDate.Date >= today);
		isUpcoming = spotlightTalk is not null;
		spotlightTalk ??= talks.LastOrDefault();
	}
}
