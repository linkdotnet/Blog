<li class="d-flex gap-3">
	<input type="text" @bind-value="@content" placeholder="Add entry (supports Markdown)" aria-label="New profile entry" class="form-control"/>
	<button type="button" class="btn btn-icon btn-subtle theme-primary" aria-label="Add Item" @onclick="@AddItemAsync">
		<i class="bi bi-plus-lg" aria-hidden="true"></i>
	</button>
</li>

@code {
    [Parameter]
    public EventCallback<string> ValueAdded { get; set; }

    private string content = string.Empty;

    private async Task AddItemAsync()
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        await ValueAdded.InvokeAsync(content);
        content = string.Empty;
    }
}
