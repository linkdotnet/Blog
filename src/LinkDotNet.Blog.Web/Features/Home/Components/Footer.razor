@using LinkDotNet.Blog.Domain
@using LinkDotNet.Blog.Web.Features.SupportMe.Components
@inject IOptions<ApplicationConfiguration> AppConfiguration
@inject IOptions<ProfileInformation> ProfileInformation
@inject IOptions<SupportMeConfiguration> SupportConfiguration
@inject NavigationManager NavigationManager
@implements IDisposable

<footer class="position-absolute bottom-0 w-100 text-center fg-3" style="height: 2.5rem;">
	<small>
	<span>© @DateTime.Now.Year @CopyrightName</span>
	<span class="d-inline-flex gap-5 ms-5">
		<a class="fg-reset underline-20 hover:underline-100" href="/feed.rss" target="_blank">RSS</a>
		<a class="fg-reset underline-20 hover:underline-100" href="/feed.rss?withContent=true" target="_blank">Full-text RSS</a>
		<AuthorizeView>
			<NotAuthorized>
				<a class="fg-reset underline-20 hover:underline-100" href="/login?redirectUri=@currentUri" rel="nofollow">Log in</a>
			</NotAuthorized>
		</AuthorizeView>
	</span>
	@if (AppConfiguration.Value.ShowBuildInformation)
	{
		<p>Made with ❤️, @BuildInformation.TargetFrameworkMoniker, and Blazor · Built At: @(BuildInformation.BuildAt.ToString("dd-MM-yyyy HH:mm")) (UTC)</p>
	}
	@if (SupportConfiguration.Value.ShowInFooter)
	{
		<div class="pb-3 d-flex justify-content-center">
			<DonationSection/>
		</div>
	}
	</small>
</footer>

@code {
    private string currentUri = string.Empty;

    private string CopyrightName => AppConfiguration.Value.IsAboutMeEnabled
        ? ProfileInformation.Value.Name
        : string.Empty;

    protected override void OnInitialized()
    {
        currentUri = NavigationManager.Uri;
        NavigationManager.LocationChanged += UpdateUri;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= UpdateUri;
    }

    private void UpdateUri(object? sender, LocationChangedEventArgs e)
    {
        currentUri = e.Location;
        StateHasChanged();
    }
}
